            "step_id": "7-6",
            "name": "Gợi ý Thumbnail",
            "description": "Layout (Split Screen/Confrontation/Evidence), Text Overlay, Nhân vật & Biểu cảm, Bảng Màu, Props"
          }
        ],

        "input": {
