{
  "pipeline": {
    "name": "HOA YouTube Video Production Pipeline",
    "version": "5.0",
    "updated": "2026-03-22",
    "description": "Pipeline sản xuất video YouTube từ Idea đến Title. File này là Single Source of Truth cho web app — parse JSON để render UI, gọi AI API, track progress. Synced với pipelineRegistry.ts.",
    "total_phases": 7,
    "estimated_total_time_min": 335,

    "phases": [
      {
        "id": "idea-evaluation",
        "phase_number": 1,
        "name": "Ý Tưởng",
        "name_en": "Idea Brainstorm",
        "icon": "💡",
        "color": "#F59E0B",
        "stage": "idea",
        "estimated_time_min": 20,
        "description": "Brainstorm ý tưởng với AI, sàng lọc & đánh giá idea. Scoring theo tiêu chí nghiên cứu từ 7 video viral (16M+ views), adapt theo nhóm pattern.",
        "description_en": "Brainstorm ideas with AI, evaluate using research-backed scoring system, determine FURY/STRATEGY/COMEDY pattern.",

        "workflows": [
          {
            "id": "danh-gia-idea",
            "file": "Idea Process/workflows/danh-gia-idea.md",
            "name": "Đánh giá idea (Phần 1)",
            "covers_steps": ["1", "1.5", "1.7", "2"]
          },
          {
            "id": "danh-gia-idea-p2",
            "file": "Idea Process/workflows/danh-gia-idea-p2.md",
            "name": "Đánh giá idea (Phần 2)",
            "covers_steps": ["3", "4", "5", "6"]
          }
        ],

        "rules_required": [],

        "steps": [
          {
            "step_id": "1-1",
            "name": "Brainstorm với AI",
            "description": "Nhập topic → AI gợi ý ideas dựa trên 9 story patterns",
            "pause_after": false
          },
          {
            "step_id": "1-1.5",
            "name": "Xác định HOA Story Pattern",
            "description": "Match idea với 9 HOA patterns (Malicious Compliance, Board Takeover, Dissolve, Sympathetic Victim, Legal Trap, Property Rights, Financial Fraud, Foreclosure, Community Comedy)",
            "pause_after": false
          },
          {
            "step_id": "1-1.7",
            "name": "Xác định nhóm scoring",
            "description": "Chọn nhóm FURY / STRATEGY / COMEDY → quyết định bộ tiêu chí chấm điểm",
            "pause_after": false
          },
          {
            "step_id": "1-2",
            "name": "Chấm điểm Universal + Pattern-Specific",
            "description": "Universal (U1-U6, /60 điểm) + Pattern-Specific (Tier S/A/B, quy đổi /40 điểm)",
            "pause_after": false
          },
          {
            "step_id": "1-3",
            "name": "Red Flags + Tính điểm tổng",
            "description": "Kiểm tra red flags, tính tổng /100, đưa verdict",
            "pause_after": true,
            "pause_message": "Trình kết quả đánh giá cho user duyệt"
          }
        ],

        "input": {
          "type": "text_or_file",
          "accept": ["text", "url", "markdown"],
          "description": "Idea câu chuyện (mô tả tóm tắt, link Reddit, concept thô, hoặc file Idea có sẵn)",
          "source_folder": "Ideas/",
          "example": "HOA bắt nạt cựu chiến binh về cột cờ trên sân nhà"
        },

        "output": {
          "type": "file",
          "folder": "Ideas/{category}/",
          "naming_pattern": "Idea-{slug}-V{version}.md",
          "example": "Ideas/Sympathetic-Victim/Idea-hoa-veteran-flagpole-sued-V1.md",
          "deliverables": [
            {
              "key": "pattern_group",
              "label": "Nhóm Pattern",
              "type": "enum",
              "values": ["FURY", "STRATEGY", "COMEDY"]
            },
            {
              "key": "score_universal",
              "label": "Điểm Universal",
              "type": "number",
              "max": 60
            },
            {
              "key": "score_pattern",
              "label": "Điểm Pattern-Specific",
              "type": "number",
              "max": 40
            },
            {
              "key": "score_total",
              "label": "Điểm Tổng",
              "type": "number",
              "max": 100
            },
            {
              "key": "red_flags",
              "label": "Red Flags",
              "type": "string_array"
            },
            {
              "key": "verdict",
              "label": "Verdict",
              "type": "enum",
              "values": ["PASS", "FAIL"],
              "pass_threshold": 70
            }
          ]
        },

        "pass_criteria": {
          "min_score": 70,
          "on_fail": "Thông báo user, hỏi tiếp tục hay chọn idea khác"
        },

        "dependencies": [],
        "can_skip": true,
        "skip_condition": "Idea đã được đánh giá trước đó (có file trong Ideas/)"
      },

      {
        "id": "outline-creation",
        "phase_number": 2,
        "name": "Dàn Ý",
        "name_en": "Outline Creation",
        "icon": "📋",
        "color": "#3B82F6",
        "stage": "outline",
        "estimated_time_min": 45,
        "description": "Tạo dàn ý chi tiết gồm Story Prep, Character Blueprint (3 C's), Story Inventory Mining, Mini Arc Map, Retention Hook Map, Emotional Ladder.",
        "description_en": "Create detailed outline including story prep, character blueprints, arc mapping, and retention hooks.",

        "workflows": [
          {
            "id": "tao-dan-y",
            "file": "Outline Process/workflow/tao-dan-y.md",
            "name": "Tạo dàn ý kịch bản",
            "covers_steps": ["all"]
          }
        ],

        "rules_required": [
          {
            "file": "Outline Process/core-rules/story-prep.md",
            "purpose": "Character Blueprint, Object, Forces, Hypocrisy"
          },
          {
            "file": "Outline Process/core-rules/structure-and-technique.md",
            "purpose": "Mini Arc, Therefore Test, Object System"
          },
          {
            "file": "Outline Process/format-rules/outline-creator.md",
            "purpose": "Output format"
          }
        ],

        "rules_excluded": [
          "Script Process/phase-rules/",
          "Script Process/format-and-wording/"
        ],

        "steps": [
          {
            "step_id": "2-step1",
            "name": "Story Prep + Character + Inventory",
            "description": "Ticking Clock, Binary Forces, Object, Transitional State, POV Audit, Character Blueprint (3 C's: Complexity/Consistency/Motivation), Story Inventory Mining",
            "sub_items": [
              "Ticking Clock — countdown/deadline",
              "Binary Forces — X vs Y (core conflict)",
              "Object — vật thể cảm xúc theo pattern",
              "Character Blueprint Hero (3-5 traits, flaw, motivation)",
              "Character Blueprint Villain (3-5 traits, conviction, motivation)",
              "Story Inventory Mining (characters, numbers, objects, irony, dialogue callback, visual moments)"
            ],
            "pause_after": true,
            "pause_message": "Trình Story Prep + Inventory cho user xác nhận TRƯỚC KHI lên arc"
          },
          {
            "step_id": "2-step2",
            "name": "Arc Map + Outline hoàn chỉnh",
            "description": "Mini Arc Mapping (Question + Mini Climax + THEREFORE + Visual Notes), Retention Hook Map, Emotional Ladder Verification, Character Blueprint Verification",
            "sub_items": [
              "Mini Arc Mapping — chia story thành arcs, QUESTION + MINI CLIMAX mỗi Part",
              "THEREFORE test — nhân quả giữa mỗi arc",
              "Retention Hook Map — hook mỗi 90-120 giây",
              "Emotional Ladder Verification",
              "Character Blueprint Verification (3 C's check)",
              "Tạo file outline"
            ],
            "pause_after": true,
            "pause_message": "Trình outline hoàn chỉnh cho user duyệt"
          }
        ],

        "input": {
          "type": "file_or_text",
          "accept": ["markdown", "text"],
          "description": "Idea đã pass + Pattern đã xác định",
          "from_phase": "idea-evaluation",
          "source_folder": "Ideas/{category}/",
          "also_reads": ["Idea Process/story-patterns/{sub-genre}.md"]
        },

        "output": {
          "type": "file",
          "folder": "Dan Y/{PATTERN}/",
          "naming_pattern": "Outline-{slug}-V{version}.md",
          "example": "Dan Y/FURY/Outline-hoa-veteran-flagpole-V1.md",
          "deliverables": [
            {
              "key": "story_inventory",
              "label": "Story Inventory",
              "type": "structured_text"
            },
            {
              "key": "mini_arc_map",
              "label": "Mini Arc Map + Visual Notes",
              "type": "structured_text"
            },
            {
              "key": "retention_hook_map",
              "label": "Retention Hook Map",
              "type": "table"
            },
            {
              "key": "emotional_ladder",
              "label": "Emotional Ladder",
              "type": "checklist"
            }
          ]
        },

        "dependencies": ["idea-evaluation"],
        "can_skip": true,
        "skip_condition": "Dàn ý đã có (file Outline tồn tại trong Dan Y/)"
      },

      {
        "id": "script-vi",
        "phase_number": 3,
        "name": "Kịch Bản Vi",
        "name_en": "Vietnamese Script",
        "icon": "✍️",
        "color": "#8B5CF6",
        "stage": "script_vi",
        "estimated_time_min": 90,
        "description": "Viết kịch bản tiếng Việt (Hook → Body → Ghép + Review). Hỗ trợ comment từng dòng để yêu cầu AI chỉnh sửa. Prose liền mạch, 3,000-4,500 từ.",
        "description_en": "Write Vietnamese script with inline commenting for AI-assisted line-by-line editing.",

        "workflows": [
          {
            "id": "viet-kich-ban",
            "file": "Script Process/workflow/viet-kich-ban.md",
            "name": "Viết kịch bản hoàn chỉnh từ dàn ý",
            "covers_steps": ["all"]
          }
        ],

        "rules_required": [
          {
            "file": "Script Process/phase-rules/phase-1-hook.md",
            "purpose": "Hook writing rules",
            "used_in_step": "3-step1"
          },
          {
            "file": "Script Process/phase-rules/phase-2-body-{pattern}.md",
            "purpose": "Body writing rules (pattern-specific)",
            "used_in_step": "3-step2",
            "variants": {
              "FURY": "phase-2-body-fury.md",
              "STRATEGY": "phase-2-body-strategy.md",
              "COMEDY": "phase-2-body-comedy.md"
            }
          },
          {
            "file": "Script Process/format-and-wording/script-format-checklist.md",
            "purpose": "Format rules",
            "used_in_step": "3-step3"
          },
          {
            "file": "Script Process/format-and-wording/script-wording-formula.md",
            "purpose": "Bảng sửa lỗi từ ngữ VI",
            "used_in_step": "3-step3"
          }
        ],

        "steps": [
          {
            "step_id": "3-step1",
            "name": "Viết Hook (P1) — Tiếng Việt",
            "description": "Reddit Synopsis (PRODUCTION ONLY block), Villain Confrontation Opening, Narrator greeting + CTA. ~400-600 từ.",
            "language": "vi",
            "sub_items": [
              "Reddit Synopsis — ngôi 1, casual, 150-250 từ",
              "Villain Opening Line — trịch thượng, action verb",
              "Teaser — 2-3 câu hỏi gợi mở, KHÔNG spoil",
              "Narrator greeting — 1 câu, nguồn gốc UNIQUE",
              "CTA nhẹ nhàng + Transition vào P2"
            ],
            "includes_sub_review": {
              "file": "Script Process/sub-review/hook-review.md",
              "description": "Sub-review hook theo checklist, sửa trực tiếp"
            },
            "word_budget": {"min": 400, "max": 600},
            "pause_after": true,
            "pause_message": "Gửi hook (tiếng Việt) cho user duyệt"
          },
          {
            "step_id": "3-step2",
            "name": "Viết Body (P2-P9) — Tiếng Việt",
            "description": "Setup (P2-P3) + Escalation (P4-P6) + Climax + Ending (P7-P9). ~3,500-4,500 từ.",
            "language": "vi",
            "sub_items": [
              "Setup — Origin + Villain intro",
              "Escalation — Destruction → Point of No Return → Build",
              "Climax + Ending — Showdown → Resolution → Closure",
              "Narrator lines bắt buộc (Engagement Pause, Punchline, CTA cuối)",
              "Visual Writing (1 câu = 1 hình)"
            ],
            "includes_sub_review": {
              "file": "Script Process/sub-review/body-{pattern}.md",
              "description": "Sub-review body theo pattern checklist, sửa trực tiếp"
            },
            "word_budget": {"min": 3500, "max": 4500},
            "pause_after": true,
            "pause_message": "Gửi body (tiếng Việt) cho user duyệt nội dung + cấu trúc"
          },
          {
            "step_id": "3-step3",
            "name": "Ghép + Tinh chỉnh",
            "description": "Ghép Hook + Body → 1 file VI liền mạch. Check format, transitions, wording formula, encoding. Tinh chỉnh từ comment inline.",
            "language": "vi",
            "sub_items": [
              "Ghép VI → 1 file liền mạch",
              "Final review (format, transitions, KT5/KT11/KT12/KT14)",
              "Kiểm tra bảng sửa lỗi từ ngữ",
              "Encoding check (mojibake → fix)"
            ],
            "pause_after": true,
            "pause_message": "Gửi script VI cho user duyệt"
          }
        ],

        "input": {
          "type": "file",
          "accept": ["markdown"],
          "description": "File dàn ý đã được user duyệt",
          "from_phase": "outline-creation",
          "source_folder": "Dan Y/{PATTERN}/"
        },

        "output": {
          "type": "file",
          "folder": "Kich Ban/VI/{PATTERN}/",
          "naming_pattern": "Script-{slug}-VI-V{version}.md",
          "example": "Kich Ban/VI/FURY/Script-hoa-veteran-flagpole-VI-V1.md",
          "format_rules": {
            "style": "prose_continuous",
            "separators": ["---"],
            "no_headers": true,
            "no_labels": true,
            "word_count": {"min": 3000, "max": 4500}
          }
        },

        "dependencies": ["outline-creation"],
        "can_skip": false
      },

      {
        "id": "review",
        "phase_number": 4,
        "name": "Review",
        "name_en": "Script Review",
        "icon": "🔍",
        "color": "#EF4444",
        "stage": "review",
        "estimated_time_min": 45,
        "description": "Review kịch bản 3 pha (Hook → Body → Final), đánh giá Universal + Pattern-Specific, cho điểm ⭐1-5 từng mục.",
        "description_en": "3-phase script review: Hook → Body → Final. Universal + pattern-specific scoring.",

        "workflows": [
          {
            "id": "review",
            "file": "Review Process/workflow/review.md",
            "name": "Review kịch bản",
            "covers_steps": ["all"]
          }
        ],

        "rules_required": [
          {
            "file": "Review Process/sub-review/hook-review.md",
            "purpose": "Hook review checklist",
            "used_in_step": "4-pha1"
          },
          {
            "file": "Review Process/sub-review/body-{pattern}.md",
            "purpose": "Body review checklist (pattern-specific)",
            "used_in_step": "4-pha2",
            "variants": {
              "FURY": "body-fury.md",
              "STRATEGY": "body-strategy.md",
              "COMEDY": "body-comedy.md"
            }
          },
          {
            "file": "Review Process/sub-review/final-review.md",
            "purpose": "Final review (format + consistency)",
            "used_in_step": "4-pha3"
          }
        ],

        "steps": [
          {
            "step_id": "4-pha1",
            "name": "Review Hook",
            "description": "Rà soát Hook: 3-step structure, Villain Line, Macro Question, KT-H1→H10, teaser, narrator"
          },
          {
            "step_id": "4-pha2",
            "name": "Review Body",
            "description": "Rà soát Body (P2-P9): Craft KT1-KT16, Pacing, Mini Arcs, Pattern-specific (Climax/Cliffhanger), Character"
          },
          {
            "step_id": "4-pha3",
            "name": "Final Review",
            "description": "Rà soát toàn bộ script: Format, Transitions, KT5 Motif, KT11 Numbers, KT12 Terminology, KT14 Dialogue Callback, Anti-patterns"
          },
          {
            "step_id": "4-fix",
            "name": "Áp dụng fixes (nếu cần)",
            "description": "Đề xuất fixes → user duyệt → áp dụng → lưu V2",
            "conditional": true,
            "condition": "verdict == 'NEEDS_FIX'",
            "pause_after": true,
            "pause_message": "Trình fixes cho user duyệt trước khi áp dụng"
          }
        ],

        "review_sections": {
          "universal": {
            "sections": [
              {"id": "A", "name": "Hook (Mở đầu)", "max_score": 5},
              {"id": "B", "name": "Macro Question", "max_score": 5},
              {"id": "C", "name": "LATDE (Kỹ thuật phân cảnh)", "max_score": 5},
              {"id": "D0", "name": "Mini Arcs & THEREFORE", "max_score": 5},
              {"id": "G", "name": "Văn Phong & Nhịp Độ (KT6-KT16)", "max_score": 5},
              {"id": "G3", "name": "Kỹ Thuật Mới (Charlotte Dobre)", "max_score": 5},
              {"id": "G4", "name": "Character Depth — 3 C's", "max_score": 5},
              {"id": "H", "name": "Tổng Quan", "max_score": 5}
            ]
          },
          "pattern_specific": {
            "FURY": {
              "sections": [
                {"id": "D-FURY", "name": "Yếu Tố Bổ Trợ (Emotional Object, Fury build-up)", "max_score": 5},
                {"id": "E-FURY", "name": "Climax 6 Lớp (Đỉnh giả → Công lý → Quiet → Mic Drop → Dây chuyền → Tự hủy)", "max_score": 5},
                {"id": "F-FURY", "name": "Micro-Cliffhanger (tension/fury, 5-7 cái)", "max_score": 5}
              ]
            },
            "STRATEGY": {
              "sections": [
                {"id": "D-STRATEGY", "name": "Yếu Tố Bổ Trợ (Evidence Trail, Research Journey, Expert-proof)", "max_score": 5},
                {"id": "E-STRATEGY", "name": "Climax Checkmate (Bối cảnh → Last stand → Bằng chứng → Checkmate → Power shift → Validation)", "max_score": 5},
                {"id": "F-STRATEGY", "name": "Micro-Cliffhanger (information-gap, 5-7 cái)", "max_score": 5}
              ]
            },
            "COMEDY": {
              "sections": [
                {"id": "D-COMEDY", "name": "Yếu Tố Bổ Trợ (Running Gag, Escalation Loop, Community Arc)", "max_score": 5},
                {"id": "E-COMEDY", "name": "Climax (Escalation peak → Overreact → Bẽ mặt → Punchline → Exit → Celebration)", "max_score": 5},
                {"id": "F-COMEDY", "name": "Micro-Cliffhanger (anticipation/vui, 4-6 cái)", "max_score": 5},
                {"id": "G-COMEDY", "name": "Kỹ Thuật Viết Hài (Zig Zig Zag, Punch-End, Keep It Lean)", "max_score": 5}
              ]
            }
          }
        },

        "input": {
          "type": "file",
          "accept": ["markdown"],
          "description": "Script VI đã viết xong",
          "from_phase": "script-vi",
          "source_folder": "Kich Ban/VI/{PATTERN}/"
        },

        "output": {
          "type": "file",
          "folder": "Review/",
          "naming_pattern": "Review-{slug}-V{version}.md",
          "example": "Review/Review-hoa-veteran-flagpole-V1.md",
          "deliverables": [
            {
              "key": "section_scores",
              "label": "Điểm từng mục",
              "type": "score_map",
              "scale": "1-5 stars"
            },
            {
              "key": "strengths",
              "label": "Top 3 điểm mạnh",
              "type": "string_array",
              "count": 3
            },
            {
              "key": "weaknesses",
              "label": "Top 3 điểm yếu",
              "type": "string_array",
              "count": 3
            },
            {
              "key": "verdict",
              "label": "Verdict",
              "type": "enum",
              "values": ["PASS", "NEEDS_FIX", "REWRITE"]
            }
          ],
          "if_needs_fix": {
            "additional_output": [
              {
                "folder": "Kich Ban/VI/{PATTERN}/",
                "naming_pattern": "Script-{slug}-VI-V{version+1}.md"
              }
            ]
          }
        },

        "dependencies": ["script-vi"],
        "can_skip": false
      },

