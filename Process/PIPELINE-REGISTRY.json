        "name_en": "VO Script Generation",
        "icon": "🎙️",
        "color": "#10B981",
        "stage": "script_vo",
        "estimated_time_min": 45,
        "description": "Chuyển Script EN → các file .txt có audio tags cho ElevenLabs. 3 Phase: Đọc & Hiểu → Chuẩn Bị → Viết & QA.",
        "description_en": "Convert EN script to .txt files with audio tags for ElevenLabs voice generation.",

        "workflows": [
          {
            "id": "tao-script-note",
            "file": "VO Process/workflow/tao-script-note.md",
            "name": "Tạo Script Note cho VO",
            "covers_steps": ["all"]
          }
        ],

        "rules_required": [
          {
            "file": "VO Process/vo-rules/vo-foundations.md",
            "purpose": "Nguyên tắc nền tảng, clean text, chia file, Beat/Pause Guide",
            "used_in_step": "6-phase1, 6-phase2"
          },
          {
            "file": "VO Process/vo-rules/vo-tags-reference.md",
            "purpose": "Danh sách tags, tonal families, pattern tags",
            "used_in_step": "6-phase1, 6-phase3"
          },
          {
            "file": "VO Process/vo-rules/vo-tagging-rules.md",
            "purpose": "Cách chèn tags (đầu dòng, mid-sentence, dialogue)",
            "used_in_step": "6-phase3"
          },
          {
            "file": "VO Process/vo-rules/vo-anti-patterns-qa.md",
            "purpose": "Lỗi cần tránh + QA checklist",
            "used_in_step": "6-phase3"
          }
        ],

        "steps": [
          {
            "step_id": "6-phase1",
            "name": "ĐỌC & HIỂU",
            "description": "Đọc kịch bản như storyteller. Ghi Narrator Mindset, Tone, Pacing, Contrast Points cho mỗi section. Map Emotional Arc + Villain Evolution + Sacred Phrases + 8 Yếu Tố.",
            "sub_items": [
              "Emotional Arc Map toàn story",
              "Villain Evolution Arc (mở → giữa → kết)",
              "Sacred Phrases / Motifs",
              "8 Yếu Tố Giọng Đọc — đánh dấu vị trí"
            ],
            "pause_after": false
          },
          {
            "step_id": "6-phase2",
            "name": "CHUẨN BỊ",
            "description": "Clean text (xóa Reddit Synopsis block, xóa ---). Chia files ≤800 từ/file, cắt ở scene transitions.",
            "sub_items": [
              "Xóa <!-- PRODUCTION ONLY --> block",
              "Xóa --- (markdown separators)",
              "Chia file theo PARTS (≤800 từ mỗi file)",
              "Naming: Part_{X}_-_{NAME}.txt"
            ],
            "pause_after": false
          },
          {
            "step_id": "6-phase3",
            "name": "VIẾT & QA",
            "description": "Gắn audio tags theo Narrator Map. QA: Clean Check + Tag Quality + Context Quality + ElevenLabs Compatibility + File Check.",
            "sub_items": [
              "Gắn tags: đầu dòng, mid-sentence, dialogue",
              "Pause = punctuation (... / , / xuống dòng)",
              "QA Clean Check (6 items)",
              "QA Tag Quality (14 items)",
              "QA Context Quality (4 items)",
              "QA ElevenLabs Compatibility (5 items)",
              "QA File Check (4 items)"
            ],
            "pause_after": true,
            "pause_message": "Trình VO files cho user duyệt"
          }
        ],

        "input": {
          "type": "file",
          "accept": ["markdown"],
          "description": "Script EN (phiên bản mới nhất sau review)",
          "from_phase": "script-en",
          "source_folder": "Kich Ban/EN/{PATTERN}/"
        },

        "output": {
          "type": "multiple_files",
          "folder": "Process VO/{slug}/",
          "naming_pattern": "Part_{letter}_{number}_-_{section_name}.txt",
          "examples": [
            "Process VO/hoa-chalk-art-rebellion/Part_A_-_HOOK.txt",
            "Process VO/hoa-chalk-art-rebellion/Part_B-1_-_TRIGGER_The_Backstory.txt",
            "Process VO/hoa-chalk-art-rebellion/Part_C-2_-_ESCALATION_Chalk_Saturday.txt"
          ],
          "format": {
            "extension": "txt",
            "encoding": "UTF-8",
            "max_words_per_file": 800,
            "content_type": "plain_text_with_audio_tags"
          }
        },

        "dependencies": ["script-en"],
        "can_skip": false
