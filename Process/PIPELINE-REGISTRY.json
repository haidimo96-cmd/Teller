        "detection": "file_exists:Dan Y/**/*.md"
      },
      {
        "id": "skip-script",
        "condition": "Script đã viết (có file Script)",
        "skip_phases": ["idea-evaluation", "outline-creation", "script-vi"],
        "detection": "file_exists:Kich Ban/VI/**/*.md"
      },
      {
        "id": "skip-to-en",
        "condition": "Script VI đã review, chỉ cần dịch EN",
        "run_only": ["script-en"],
        "detection": "user_request"
      },
      {
        "id": "only-vo",
        "condition": "Chỉ cần VO",
        "run_only": ["vo-script"],
        "detection": "user_request"
      },
      {
        "id": "only-title",
        "condition": "Chỉ cần Title",
        "run_only": ["title-generation"],
        "detection": "user_request"
      }
